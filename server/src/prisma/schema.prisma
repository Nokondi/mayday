generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PostType {
  REQUEST
  OFFER
}

enum PostStatus {
  OPEN
  FULFILLED
  CLOSED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecurrenceFrequency {
  DAY
  WEEK
  MONTH
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum BugReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}


enum PendingInviteStatus {
  PENDING
  CLAIMED
  REVOKED
  EXPIRED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  bio          String?
  location     String?
  latitude     Float?
  longitude    Float?
  skills       String[]
  avatarUrl    String?
  links        Json?
  role         Role     @default(USER)
  isBanned     Boolean  @default(false)
  emailVerified Boolean  @default(false)
  emailNotificationsEnabled Boolean @default(true)
  pushNotificationsEnabled  Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts            Post[]
  sentMessages     Message[]      @relation("sender")
  receivedMessages Message[]      @relation("receiver")
  reportsFiled     Report[]       @relation("reporter")
  reportsAgainst   Report[]       @relation("reportedUser")
  conversationsAsA Conversation[] @relation("participantA")
  conversationsAsB Conversation[] @relation("participantB")
  orgMemberships        OrganizationMember[]
  invitesReceived       OrganizationInvite[]  @relation("inviteRecipient")
  invitesSent           OrganizationInvite[]  @relation("inviteSender")
  communityMemberships  CommunityMember[]
  communityInvitesRecv  CommunityInvite[]     @relation("communityInviteRecipient")
  communityInvitesSent  CommunityInvite[]     @relation("communityInviteSender")
  communityJoinRequests CommunityJoinRequest[]
  fulfillments          PostFulfillment[]
  comments              Comment[]
  bugReports            BugReport[]
  pendingCommunityInvitesSent    PendingCommunityInvite[]    @relation("pendingCommunityInviteSender")
  pendingOrganizationInvitesSent PendingOrganizationInvite[] @relation("pendingOrganizationInviteSender")
  pushSubscriptions              PushSubscription[]
  devices                        Device[]
  friendRequestsSent     FriendRequest[] @relation("friendRequestSender")
  friendRequestsReceived FriendRequest[] @relation("friendRequestRecipient")
  friendshipsAsA         Friendship[]    @relation("friendshipA")
  friendshipsAsB         Friendship[]    @relation("friendshipB")
}

model Post {
  id             String       @id @default(uuid())
  type           PostType
  status         PostStatus   @default(OPEN)
  // Post audience is a union: visible to members of any community in the
  // PostCommunity join table, plus the author's friends when sharedWithFriends
  // is true. No communities and sharedWithFriends=false ⇒ public.
  sharedWithFriends Boolean   @default(false)
  title          String
  description    String
  category       String
  location       String?
  latitude       Float?
  longitude      Float?
  urgency        UrgencyLevel @default(MEDIUM)
  authorId       String
  organizationId String?
  startAt        DateTime?
  endAt          DateTime?
  recurrenceFreq     RecurrenceFrequency?
  recurrenceInterval Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  author       User          @relation(fields: [authorId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  communities  PostCommunity[]
  reports      Report[]
  images       PostImage[]
  fulfillments PostFulfillment[]
  comments     Comment[]

  @@index([category])
  @@index([type])
  @@index([status])
  @@index([authorId])
  @@index([organizationId])
  @@index([latitude, longitude])
}

// Join table linking a post to the communities it's scoped to. A post with no
// rows here is public; a post with one or more rows is visible only to members
// of any of those communities. Replaces the former single Post.communityId FK.
model PostCommunity {
  postId      String
  communityId String

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([postId, communityId])
  @@index([communityId])
}

model PostImage {
  id        String   @id @default(uuid())
  url       String
  order     Int      @default(0)
  postId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostFulfillment {
  id             String   @id @default(uuid())
  postId         String
  name           String
  userId         String?
  organizationId String?
  createdAt      DateTime @default(now())

  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([userId])
  @@index([organizationId])
}

// A flat (non-nested) comment on a post. Every comment is a direct child of the
// post; there is no parent-comment FK. editedAt is set when the body is changed
// after creation and drives the "edited" tag in the UI. Deletes are hard — the
// row is removed entirely (no tombstone), and cascade-removed with the post.
model Comment {
  id        String    @id @default(uuid())
  postId    String
  authorId  String
  body      String
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([postId, createdAt])
  @@index([authorId])
}

model Conversation {
  id             String   @id @default(uuid())
  participantAId String
  participantBId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participantA User      @relation("participantA", fields: [participantAId], references: [id])
  participantB User      @relation("participantB", fields: [participantBId], references: [id])
  messages     Message[]
  keyWraps     ConversationKeyWrap[]

  @@unique([participantAId, participantBId])
}

model Message {
  id             String    @id @default(uuid())
  // Message kind. "TEXT" is an ordinary user message (plaintext or encrypted,
  // per the fields below). "INVITE" is a server-authored organization/community
  // invitation rendered as an actionable card — its details live in `metadata`,
  // it is never encrypted, and `content` stays NULL.
  type           String    @default("TEXT")
  // Structured payload for non-TEXT messages. For "INVITE": { inviteKind,
  // inviteId, targetId, targetName, status }. NULL for ordinary messages.
  metadata       Json?
  // Plaintext body — only set for legacy (pre-E2EE) messages. New messages
  // sent under E2EE leave this NULL and populate the ciphertext fields below.
  content        String?
  // E2EE envelope. ciphertext + nonce decrypt under the conversation key for
  // (conversationId, keyEpoch). senderDeviceId identifies which device of the
  // sender produced the envelope. protocolVersion lets clients migrate to a
  // future Double Ratchet (Level B) scheme without forced re-registration.
  ciphertext      Bytes?
  nonce           Bytes?
  senderDeviceId  String?
  keyEpoch        Int?
  protocolVersion Int?
  senderId       String
  receiverId     String
  conversationId String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  sender       User         @relation("sender", fields: [senderId], references: [id])
  receiver     User         @relation("receiver", fields: [receiverId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
}

// One row per (conversation, recipient device) pair. wrappedKey is the
// conversation key sealed to the device's X25519 public key. Multiple
// epochs let us rotate the CK without breaking access to older messages —
// each Message references the keyEpoch that decrypts it.
model ConversationKeyWrap {
  id             String   @id @default(uuid())
  conversationId String
  deviceId       String
  wrappedKey     Bytes
  keyEpoch       Int      @default(1)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([conversationId, deviceId, keyEpoch])
  @@index([deviceId])
  @@index([conversationId])
}

model Report {
  id             String       @id @default(uuid())
  reason         String
  details        String?
  status         ReportStatus @default(PENDING)
  reporterId     String
  reportedUserId String?
  postId         String?
  resolvedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter     User  @relation("reporter", fields: [reporterId], references: [id])
  reportedUser User? @relation("reportedUser", fields: [reportedUserId], references: [id])
  post         Post? @relation(fields: [postId], references: [id])
}

model BugReport {
  id          String          @id @default(uuid())
  title       String
  description String
  status      BugReportStatus @default(OPEN)
  reporterId  String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  reporter User @relation(fields: [reporterId], references: [id])

  @@index([status])
  @@index([reporterId])
}

model Announcement {
  id        String   @id @default(uuid())
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, createdAt])
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  description String?
  location    String?
  latitude    Float?
  longitude   Float?
  avatarUrl   String?
  links       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members         OrganizationMember[]
  invites         OrganizationInvite[]
  pendingInvites  PendingOrganizationInvite[]
  posts           Post[]
  fulfillments    PostFulfillment[]

  @@index([name])
  @@index([latitude, longitude])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole  @default(MEMBER)
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvite {
  id              String       @id @default(uuid())
  organizationId  String
  invitedUserId   String
  invitedById     String
  status          InviteStatus @default(PENDING)
  // Back-link to the actionable invite-message card in the inviter↔invitee
  // conversation, so accept/decline/revoke can update the card's rendered status.
  inviteMessageId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedUser  User         @relation("inviteRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("inviteSender", fields: [invitedById], references: [id])

  @@unique([organizationId, invitedUserId])
  @@index([invitedUserId])
  @@index([status])
}

model Community {
  id          String   @id @default(uuid())
  name        String
  description String?
  location    String?
  latitude    Float?
  longitude   Float?
  avatarUrl   String?
  links       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        CommunityMember[]
  invites        CommunityInvite[]
  pendingInvites PendingCommunityInvite[]
  joinRequests   CommunityJoinRequest[]
  posts          PostCommunity[]

  @@index([name])
  @@index([latitude, longitude])
}

model CommunityMember {
  id          String   @id @default(uuid())
  communityId String
  userId      String
  role        OrgRole  @default(MEMBER)
  joinedAt    DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityInvite {
  id            String       @id @default(uuid())
  communityId   String
  invitedUserId String
  invitedById   String
  status        InviteStatus @default(PENDING)
  // Back-link to the actionable invite-message card in the inviter↔invitee
  // conversation, so accept/decline/revoke can update the card's rendered status.
  inviteMessageId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  invitedUser User      @relation("communityInviteRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("communityInviteSender", fields: [invitedById], references: [id])

  @@unique([communityId, invitedUserId])
  @@index([invitedUserId])
  @@index([status])
}

model FriendRequest {
  id          String       @id @default(uuid())
  senderId    String
  recipientId String
  status      InviteStatus @default(PENDING)
  // Back-link to the actionable friend-request card in the sender↔recipient
  // conversation, so accept/decline/revoke can update the card's rendered status.
  requestMessageId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sender    User @relation("friendRequestSender",    fields: [senderId],    references: [id], onDelete: Cascade)
  recipient User @relation("friendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId])
  @@index([recipientId])
  @@index([status])
}

// An accepted friendship. Stored once per pair with userAId < userBId (sorted,
// mirroring Conversation) so the relationship is order-independent and unique.
model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("friendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("friendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

model CommunityJoinRequest {
  id          String       @id @default(uuid())
  communityId String
  userId      String
  status      InviteStatus @default(PENDING)
  message     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@index([status])
}

model PendingCommunityInvite {
  id           String              @id @default(uuid())
  token        String              @unique
  email        String
  communityId  String
  invitedById  String
  status       PendingInviteStatus @default(PENDING)
  expiresAt    DateTime
  claimedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("pendingCommunityInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([communityId, email])
  @@index([email, status])
  @@index([status])
}

model PendingOrganizationInvite {
  id              String              @id @default(uuid())
  token           String              @unique
  email           String
  organizationId  String
  invitedById     String
  status          PendingInviteStatus @default(PENDING)
  expiresAt       DateTime
  claimedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("pendingOrganizationInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email, status])
  @@index([status])
}

model PushSubscription {
  id            String   @id @default(uuid())
  userId        String
  endpoint      String   @unique
  p256dh        String
  auth          String
  userAgent     String?
  lastSuccessAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// End-to-end encryption device. Each browser/install of the app registers one
// Device with two public keys: an Ed25519 signing key (identity) and an X25519
// encryption key signed by it. Private keys never leave the client. See
// memory/e2ee_design_decisions.md and the Phase 1 plan in chat for context.
model Device {
  id                  String    @id @default(uuid())
  userId              String
  // 32-byte Ed25519 public key — used now for the fingerprint and ready for
  // X3DH-style prekey signing if we ever upgrade to forward secrecy (Level B).
  signingPublicKey    Bytes
  // 32-byte X25519 public key — recipients seal the conversation key to this.
  encryptionPublicKey Bytes
  // Ed25519 signature over encryptionPublicKey, proving the same device owns both.
  encryptionKeySig    Bytes
  label               String?
  createdAt           DateTime  @default(now())
  lastSeenAt          DateTime?
  revokedAt           DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyWraps ConversationKeyWrap[]

  @@index([userId])
  @@index([userId, revokedAt])
}
