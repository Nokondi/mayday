{
  "name": "@mayday/client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint:a11y": "eslint \"src/**/*.{ts,tsx}\"",
    "i18n:extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore \"src/i18n/**\" --ignore \"src/**/*.d.ts\" --out-file src/i18n/extracted/en.json",
    "i18n:compile": "formatjs compile src/i18n/extracted/en.json --ast --out-file src/i18n/compiled/en.json",
    "i18n": "npm run i18n:extract && npm run i18n:compile",
    "i18n:check": "npm run i18n && git diff --exit-code src/i18n"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@mayday/shared": "*",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "libsodium-wrappers": "^0.7.15",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-intl": "^7.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.0",
    "sonner": "^1.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@formatjs/cli": "^5.1.13",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.15",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "babel-plugin-formatjs": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.4"
  }
}
